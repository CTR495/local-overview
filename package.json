{
  "name": "local-overview",
  "version": "0.1.0",
  "private": true,
  "description": "An independent Google Search extension with local Ollama overviews.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "check": "tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "verify": "npm run check && npm test && npm run build && node scripts/verify-build.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/chrome": "^0.1.25",
    "@types/node": "^22.18.12",
    "esbuild": "^0.25.11",
    "jsdom": "^27.0.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
